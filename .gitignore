# macOS
.DS_Store

# Logs and binaries
*.log
*.bin
*.elf
*.map
*.hex
*.o
*.d

# Python transient files
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# ESP-IDF Component Manager (fetched at build time; manifest is the source of truth)
managed_components/
dependencies.lock

# Developer-only TLS material — never committed. Generated by
# tools/gen_dev_cert.sh; embedded at build time for dev-mode firmware.
tools/dev_cert.pem
tools/dev_key.pem

# ESP-IDF/CMake generated artifacts
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
sdkconfig.old
sdkconfig.luce_*
sdkconfig.default
sdkconfig.net*

# VS Code local settings
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
docs/work/inv/*
docs/work/diag/*
docs/work/plan/*
!docs/work/inv/.gitkeep
!docs/work/inv/legacy.md
!docs/work/diag/.gitkeep
!docs/work/plan/.gitkeep

# Skill/agent scratch output
.agent/tmp/
.agent/tmp/**/*
